{
  "name": "foodgapp-wellnu-tests",
  "version": "1.0.0",
  "description": "Complete testing suite for WellNū FoodGApp system",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:components": "jest --testPathPattern=Components.test.tsx",
    "test:services": "jest --testPathPattern=WellNuSystem.test.ts",
    "test:performance": "jest --testPathPattern=Performance.test.ts",
    "test:e2e": "node selenium-tests/wellnu-e2e-tests.js",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.0",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "expo": "~49.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.0",
    "@react-native/metro-config": "^0.72.0",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.1.2",
    "@types/jest": "^29.5.2",
    "@types/react": "~18.2.14",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "jest-environment-jsdom": "^29.5.0",
    "jest-expo": "~49.0.0",
    "react-test-renderer": "18.2.0",
    "selenium-webdriver": "^4.10.0",
    "chromedriver": "^114.0.2",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "./jest.setup.js"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(ts|tsx)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "services/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx|js)"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "babel": {
    "presets": [
      "babel-preset-expo"
    ]
  },
  "eslintConfig": {
    "extends": "@react-native",
    "rules": {
      "prettier/prettier": "off",
      "@typescript-eslint/no-unused-vars": "warn"
    }
  }
}
