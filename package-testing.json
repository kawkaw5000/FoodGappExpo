{
  "name": "wellnu-testing-suite",
  "version": "1.0.0",
  "description": "Comprehensive testing setup for WellNū intelligent nutrition app",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:selenium": "node selenium-tests/wellnu-e2e-tests.js",
    "test:full": "npm run test && npm run test:selenium",
    "lint:test": "eslint __tests__/ selenium-tests/",
    "setup:selenium": "npm install selenium-webdriver chromedriver",
    "start:test-server": "expo start --web",
    "validate:app": "npm run lint && npm run test:coverage && npm run test:selenium"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "jest-expo": "^51.0.0",
    "selenium-webdriver": "^4.15.0",
    "chromedriver": "^119.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@testing-library/jest-native": "^5.4.0",
    "eslint": "^8.50.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "services/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/*.test.{ts,tsx}",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"]
  }
}
